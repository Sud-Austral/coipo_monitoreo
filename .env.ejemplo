# Credenciales de los canales de alerta.
#
# Copiar como .env en el servidor donde corre el monitoreo. NO se versiona en git.
# Sin este archivo el monitoreo funciona igual: el canal 'log' no necesita nada, y
# escribe todo en datos/coipo_monitoreo.log.
#
# Para que salgan correos hay que agregar 'email' a alertas.canales en config/dominios.yml.

# --- Correo
SMTP_HOST=
SMTP_PUERTO=25
SMTP_TLS=0
SMTP_USUARIO=
SMTP_CLAVE=
ALERTA_DE=monitoreo@conaf.cl
ALERTA_PARA=

# --- Webhook generico (Teams, Slack, o lo que sea que acepte un POST con JSON)
WEBHOOK_URL=

# Probar los canales configurados sin esperar a que algo se caiga:
#   python -m coipo_monitoreo probar-alerta
